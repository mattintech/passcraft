{
  "name": "passcraft",
  "version": "1.1.0",
  "description": "Secure, account-free password and Diceware passphrase generator extension for Firefox and Chrome.",
  "scripts": {
    "test": "node test.js",
    "test:e2e": "node test-e2e.js",
    "test:all": "npm test && npm run test:e2e",
    "build:zip": "rm -f passcraft-extension.zip && zip -r passcraft-extension.zip . -x '*.git*' '*.DS_Store' 'CHROMEWEBSTORE.md' 'node_modules/*' 'test*.js' 'package*.json' 'passcraft-extension.zip' 'promo/*' 'docs/*'"
  },
  "keywords": [
    "password-generator",
    "passphrase",
    "diceware",
    "browser-extension",
    "chrome-extension",
    "firefox-addon",
    "security",
    "offline"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "puppeteer": "^25.16.0"
  }
}
