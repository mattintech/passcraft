{
  "manifest_version": 3,
  "name": "PassCraft - Offline Password & Passphrase Generator",
  "version": "1.0.0",
  "description": "Secure, account-free password and Diceware passphrase generator with zero network tracking, entropy meter, and optional history.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "PassCraft Generator",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "permissions": [
    "storage",
    "clipboardWrite"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "passcraft@local",
      "strict_min_version": "109.0"
    }
  }
}
